{
  "expo": {
    "name": "NATIVA Repartidor",
    "slug": "nativa-repartidor",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#0f2142",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0f2142"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2142"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NATIVA necesita tu ubicación para mostrar la posición del repartidor en tiempo real."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NATIVA necesita tu ubicación para mostrar la posición del repartidor en tiempo real."
        }
      ]
    ]
  }
}
